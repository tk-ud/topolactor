# Copy this file to infra/.env and fill in values.
# docker compose --env-file infra/.env -f infra/docker-compose.yml up -d

# ---------- Shared runtime wiring (required) ----------
# Required backend DB connection string used by backend/Program.cs startup validation.
DATABASE_URL=Host=postgres;Database=topolactor_demo;Username=topolactor_demo;Password=topolactor_demo

# Internal service ports are fixed in compose for route-wiring consistency:
# backend:5000, frontend:8000, nginx upstreams and backend healthcheck must match.

# Fresh API proxy target for standalone frontend mode. In compose this should point to backend service.
DEMO_BACKEND_URL=http://backend:5000

# ---------- Demo JWT auth boundary (required for demo auth) ----------
# Required — shared secret for HS256 JWT signing.
DEMO_JWT_SECRET=topolactor-local-dev-secret-change-me

# Required — positive integer; JWT token lifetime in hours.
DEMO_JWT_EXPIRY_HOURS=8

# Optional — display-only issuer claim in the JWT. Defaults to "topolactor-demo".
# DEMO_JWT_ISSUER=topolactor-demo
