# Copy this file to infra/.env and fill in the required values.
# docker-compose reads infra/.env automatically when run from the infra/ directory,
# or pass it explicitly: docker compose --env-file infra/.env -f infra/docker-compose.yml up -d

# Required — shared secret for HS256 JWT signing.
# Use a long random string (e.g. openssl rand -hex 32).
DEMO_JWT_SECRET=

# Required — positive integer; JWT token lifetime in hours.
DEMO_JWT_EXPIRY_HOURS=8

# Optional — display-only issuer claim in the JWT. Defaults to "topolactor-demo".
# DEMO_JWT_ISSUER=topolactor-demo
