# infra/.env.example — copy to infra/.env and fill in real values.
# Required by docker-compose.yml for backend and frontend services.
# Postgres uses hardcoded credentials (POSTGRES_USER/PASSWORD/DB in docker-compose.yml).

# Backend — required
# Npgsql expects ADO.NET key=value format (not postgres:// URI).
DATABASE_URL=Host=postgres;Port=5432;Database=topolactor_demo;Username=topolactor_demo;Password=topolactor_demo
DEMO_JWT_SECRET=replace-with-a-strong-secret
DEMO_JWT_EXPIRY_HOURS=24

# Backend — optional (defaults shown)
DEMO_JWT_ISSUER=topolactor-demo

# Frontend — optional (defaults shown)
DEMO_BACKEND_URL=http://backend:5000

# Cookie security — optional (defaults shown)
# Set COOKIE_SECURE=true for HTTPS/production deployments to add Secure attribute to refresh token cookie.
# Absent or false is the explicit local/demo HTTP exception (Secure attribute omitted).
COOKIE_SECURE=false
