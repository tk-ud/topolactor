# Deno npm cache (generated by deno install)
node_modules/

# .NET build artifacts
bin/
obj/

# Python bytecode cache (governance tooling scripts under .agent/scripts)
__pycache__/
*.pyc

# Deno lockfile (generated by local Deno version; CI uses Deno v1.x)
deno.lock

# Local environment files
infra/.env
frontend/.env

# Agent temporary planning memo (must not be committed)
.agent/tmp/*
!.agent/tmp/.gitkeep

# Windows reserved device names (accidental redirect artifacts)
nul

# topology-seed-discussion generated local artifacts
.agent/tmp/topology-seed-discussion*.json
topology-seed-discussion*.tmp.json
topology-seed-discussion*.seed.json
