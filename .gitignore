# Deno npm cache (generated by deno install)
node_modules/

# .NET build artifacts
bin/
obj/

# Python bytecode cache (governance tooling scripts under .agent/scripts)
__pycache__/
*.pyc

# Deno lockfile (generated by local Deno version; CI uses Deno v1.x)
deno.lock

# Local environment files
infra/.env
frontend/.env

# Agent temporary planning memo (must not be committed)
.agent/tmp/*
!.agent/tmp/.gitkeep
senario-tmp.md

# Windows reserved device names (accidental redirect artifacts)
nul

# topology-seed-discussion generated local artifacts
.agent/tmp/topology-seed-discussion*.json
topology-seed-discussion*.tmp.json
topology-seed-discussion*.seed.json

# react-schema-topology-seed-translator local/tmp regeneration output.
# Not tracked evidence: *seed.sql / SSOT docs are the production storage
# authority; .agent/tools/logs/generate.log is the tracked trace evidence
# (JSON Lines, one line per generation) that lets a regeneration proof
# recreate these files on demand and hash-check them. Do not ignore
# .agent/tools/logs/* or any *seed.sql file.
.agent/tools/generated/*
!.agent/tools/generated/.gitkeep
