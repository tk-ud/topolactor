# frontend/.env.example — copy to frontend/.env for local Fresh dev (Route A).
# Loaded automatically by deno.json tasks via --env-file=frontend/.env.
# Docker Compose frontend uses infra/.env instead (DEMO_BACKEND_URL=http://backend:5000).

DEMO_BACKEND_URL=http://localhost:5000

# Local dev: stop Docker frontend first, then `deno task dev` → http://localhost:8000
#   docker stop topolactor-demo-frontend
# Full stack demo (no local Fresh): `docker compose -f infra/docker-compose.yml up -d` → http://localhost (nginx)
